{
  "name": "@focient/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "tsx --test --test-concurrency=1 --test-timeout=20000 test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage test/workload-engine.test.ts test/top-3-priority.test.ts test/placement-engine.test.ts test/reschedule-engine.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@focient/contracts": "*",
    "@focient/database": "*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "next": "16.4.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}

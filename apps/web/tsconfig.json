{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@focient/contracts": ["../../packages/contracts/src/index.ts"],
      "@focient/contracts/*": ["../../packages/contracts/src/*"],
      "@focient/database": ["../../packages/database/src/index.ts"],
      "@focient/database/*": ["../../packages/database/src/*"],
      "@focient/ui-tokens": ["../../packages/ui-tokens/src/index.ts"],
      "@focient/ui-tokens/*": ["../../packages/ui-tokens/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

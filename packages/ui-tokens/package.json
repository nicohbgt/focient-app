      "types": "./src/icon-token.d.ts",
      "default": "./src/icon-token.js"
    },
    "./icon-token.json": "./tokens/icon-token.json",
    "./typography-token.css": "./src/typography-token.css",
    "./typography-token": {
      "types": "./src/typography-token.d.ts",

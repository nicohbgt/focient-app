    "./border-radius-token.json": "./tokens/border-radius-token.json",
    "./animation-token.css": "./src/animation-token.css",
    "./animation-token": {
      "types": "./src/animation-token.d.ts",
      "default": "./src/animation-token.js"
    },
    "./animation-token.json": "./tokens/animation-token.json",
    "./shadow-token.css": "./src/shadow-token.css",
    "./shadow-token": {

# FoCient Environment Configuration Template
# Duplicate this file to .env and configure secrets

# -----------------------------------------------------------------------------
# Server & Runtime (Backend Engine)
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Database & In-Memory Cache (PostgreSQL & Redis)
# -----------------------------------------------------------------------------
POSTGRES_USER=focient
POSTGRES_PASSWORD=generate_a_secure_password_for_production
POSTGRES_DB=focient_db
DATABASE_URL=postgresql://focient:generate_a_secure_password_for_production@localhost:5432/focient_db?schema=public
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Authentication & Security (Hybrid Auth: Google OAuth 2.0 OIDC + Manual Email JWT)
# Generate secrets with: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_min_32_chars_cryptographic_secret
JWT_REFRESH_SECRET=replace_with_min_32_chars_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=replace_with_min_32_chars_otp_secret
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# Email Provider (Real Email Delivery for OTP Verification)
# Options: test (sandbox/memory), resend (REST API), smtp (SMTP Server)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=test
EMAIL_FROM=FoCient <support@focient.dev>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Integrations (OAuth & AI Modular Extensions)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_MOBILE_CLIENT_ID=
APPLE_CLIENT_ID=
GEMINI_API_KEY=
LITELLM_ENDPOINT=

# -----------------------------------------------------------------------------
# Monitoring & Logging (Sentry & PostHog)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
POSTHOG_API_KEY=

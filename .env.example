# FoCient Environment Configuration Template
# Duplicate this file to .env and configure secrets

# -----------------------------------------------------------------------------
# Server & Runtime (Backend Engine)
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Database & In-Memory Cache (PostgreSQL & Redis)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://focient:focient_password@localhost:5432/focient_db?schema=public
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Authentication & Security (Hybrid Auth: Google OAuth 2.0 + Manual Email JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=focient_super_secure_random_string_change_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# Integrations (OAuth & AI Modular Extensions)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
GEMINI_API_KEY=
LITELLM_ENDPOINT=

# -----------------------------------------------------------------------------
# Monitoring & Logging (Sentry & PostHog)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
POSTHOG_API_KEY=
